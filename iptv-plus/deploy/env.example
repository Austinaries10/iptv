# Copy to /opt/iptv-plus/.env on the VPS and edit. Never commit the real file.

# Required: password for the site
PASSWORD=change-me

# Recommended: signing key for sessions (generate with: openssl rand -hex 32)
PROXY_SECRET=

# Optional: port on the VPS (default 80 → http://your-ip/)
# HOST_PORT=80

# Optional: preset sources for every visitor (see docs/LIBRETV-README.md)
# DEFAULT_LIVE_SOURCES=[{"name":"Free TV","url":"https://iptv-org.github.io/iptv/index.m3u"}]
# DEFAULT_SOURCES=[{"name":"My source","url":"https://example.com/api.php/provide/vod"}]
